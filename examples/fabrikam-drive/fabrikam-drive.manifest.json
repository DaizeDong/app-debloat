{
  "schema": 2,
  "id": "fabrikam-drive",
  "name": "Fabrikam Drive",
  "taskPrefix": "FabrikamDrive",
  "profile": "electron-netdisk",
  "riskTier": "normal",
  "installRoot": {
    "envVar": "FABRIKAMDRIVE_ROOT",
    "uninstall": {
      "displayName": "^Fabrikam Drive"
    },
    "candidates": [
      "%LOCALAPPDATA%\\Programs\\FabrikamDrive"
    ],
    "mustContain": [
      "FabrikamDrive.exe",
      "resources\\app.asar"
    ],
    "identity": {
      "text": [
        {
          "file": "resources\\build-info.json",
          "regex": "\"name\"\\s*:\\s*\"fabrikam-drive\""
        }
      ]
    }
  },
  "pathVars": {
    "updaterCache": {
      "envVar": "FABRIKAMDRIVE_UPDATERCACHE",
      "default": "%LOCALAPPDATA%\\fabrikam-drive-updater"
    },
    "appData": {
      "envVar": "FABRIKAMDRIVE_APPDATA",
      "default": "%APPDATA%\\FabrikamDrive"
    }
  },
  "allowedRoots": [
    "{updaterCache}",
    "{appData}"
  ],
  "version": {
    "sources": [
      {
        "source": "uninstall"
      },
      {
        "source": "file",
        "path": "{root}\\FabrikamDrive.exe"
      },
      {
        "source": "text",
        "path": "{root}\\resources\\build-info.json",
        "regex": "\"version\"\\s*:\\s*\"([^\"]+)\""
      }
    ],
    "supported": {
      "versions": [
        "5.3.1"
      ]
    }
  },
  "core": {
    "files": [
      "{root}\\FabrikamDrive.exe",
      "{root}\\FabrikamDriveHost.exe",
      "{root}\\resources\\app.asar"
    ],
    "preserve": [
      "{appData}\\settings.json"
    ],
    "processes": [
      "FabrikamDrive.exe",
      "FabrikamDriveHost.exe"
    ],
    "restartable": [],
    "services": [
      "FabrikamDriveSyncSvc"
    ],
    "probe": "sign in with a test account, upload and download a small file"
  },
  "options": [
    {
      "name": "KeepAi",
      "default": false,
      "help": "Keep the AI assistant plugin."
    },
    {
      "name": "BlockHosts",
      "default": false,
      "help": "Also sink ad and telemetry hosts in the hosts file (discouraged: flagged by security products)."
    },
    {
      "name": "RemoveUpdaterExe",
      "default": false,
      "help": "Replace FabrikamUpdate.exe with a placeholder. Promote by: start the client with the updater renamed and confirm sign-in and transfers."
    },
    {
      "name": "BlockReporter",
      "default": false,
      "help": "Firewall FabrikamReport.exe. Promote by: a Sysmon 22 capture showing it contacts only telemetry hosts."
    }
  ],
  "actions": [
    {
      "id": "updater-task",
      "type": "task-disable",
      "category": "updater",
      "rationale": [
        "L-R1"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "target": [
        "\\FabrikamDrive\\FabrikamDriveUpdateTask*"
      ]
    },
    {
      "id": "updater-system-tasks",
      "type": "task-disable",
      "category": "updater",
      "rationale": [
        "L-R6"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "taskPath": "\\FabrikamUpdaterSystem\\",
      "target": [
        "FabrikamUpdater*"
      ]
    },
    {
      "id": "updater-svc",
      "type": "service-disable",
      "category": "updater",
      "rationale": [
        "L-R2"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "target": [
        "FabrikamDriveUpdateSvc",
        "FabrikamDriveElevationSvc"
      ],
      "stop": true,
      "knownFailure": {
        "reason": "a security suite vetoes the start-type change (access denied, protection level NONE)",
        "ref": "L-R2",
        "targets": [
          "FabrikamDriveElevationSvc"
        ]
      }
    },
    {
      "id": "updater-config",
      "type": "file-placeholder-dir",
      "category": "updater",
      "rationale": [
        "L-R3"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "createIfMissing": true,
      "target": [
        "{root}\\resources\\app-update.yml"
      ]
    },
    {
      "id": "updater-cache",
      "type": "acl-deny-write",
      "category": "updater",
      "rationale": [
        "L-R4"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "principal": "CurrentUser",
      "emptyFirst": true,
      "createIfMissing": true,
      "target": [
        "{updaterCache}"
      ]
    },
    {
      "id": "updater-exe",
      "type": "file-placeholder-dir",
      "category": "updater",
      "rationale": [
        "L-R5"
      ],
      "evidence": "hypothesis",
      "reversible": true,
      "reapply": true,
      "when": "RemoveUpdaterExe",
      "evidenceNote": "client tolerance of a missing updater is untested",
      "target": [
        "{root}\\FabrikamUpdate.exe"
      ]
    },
    {
      "id": "ad-helpers",
      "type": "file-placeholder-dir",
      "category": "ad",
      "rationale": [
        "L-A1"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "target": [
        "{root}\\ad_helper.exe",
        "{root}\\resources\\plugins\\promo_popup.exe"
      ]
    },
    {
      "id": "ai-plugin",
      "type": "dir-placeholder-file",
      "category": "ai",
      "rationale": [
        "L-A2"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "unless": "KeepAi",
      "target": [
        "{root}\\resources\\plugins\\ai-assistant"
      ]
    },
    {
      "id": "shellext",
      "type": "shellext-block",
      "category": "promo",
      "rationale": [
        "L-P1"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "clsids": [
        "{FAB00000-CCCC-4DDD-8EEE-FFFF00001111}"
      ],
      "handlerMatch": "^FabrikamDrive",
      "label": "Fabrikam Drive context menu"
    },
    {
      "id": "toast",
      "type": "toast-off",
      "category": "ad",
      "rationale": [
        "L-A3"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "target": [
        "com.fabrikam.drive*"
      ]
    },
    {
      "id": "settings",
      "type": "reg-set",
      "category": "ad",
      "rationale": [
        "L-A4"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "target": "HKCU\\Software\\Fabrikam\\Drive",
      "kind": "DWord",
      "values": {
        "ShowPromotions": 0,
        "AiAssistantEnabled": 0
      }
    },
    {
      "id": "promo-banner",
      "type": "json-set",
      "category": "ad",
      "rationale": [
        "L-A5"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "path": "{appData}\\settings.json",
      "pointer": "/promotions/showBanner",
      "value": false,
      "onlyWhenNotRunning": [
        "{root}\\FabrikamDrive.exe"
      ]
    },
    {
      "id": "ai-entry",
      "type": "json-set",
      "category": "ai",
      "rationale": [
        "L-A6"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "unless": "KeepAi",
      "path": "{appData}\\settings.json",
      "pointer": "/ai/assistant/enabled",
      "value": false,
      "onlyWhenNotRunning": [
        "{root}\\FabrikamDrive.exe"
      ]
    },
    {
      "id": "report-net",
      "type": "firewall-block-program",
      "category": "telemetry",
      "rationale": [
        "L-T1"
      ],
      "evidence": "inferred",
      "reversible": true,
      "reapply": true,
      "when": "BlockReporter",
      "evidenceNote": "name and strings suggest crash and usage reports only",
      "target": [
        "{root}\\FabrikamReport.exe"
      ]
    },
    {
      "id": "ifeo",
      "type": "ifeo-block",
      "category": "updater",
      "rationale": [
        "L-R5",
        "L-A1"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": true,
      "target": [
        "FabrikamUpdate.exe",
        "FabrikamAdHelper.exe"
      ]
    },
    {
      "id": "promo-cache",
      "type": "reg-delete-key",
      "category": "promo",
      "rationale": [
        "L-P2"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": false,
      "effect": "reset",
      "target": [
        "HKCU\\Software\\Fabrikam\\Drive\\PromoCache"
      ]
    },
    {
      "id": "hosts",
      "type": "hosts-block",
      "category": "telemetry",
      "rationale": [
        "L-T2"
      ],
      "evidence": "observed",
      "reversible": true,
      "reapply": false,
      "when": "BlockHosts",
      "acknowledgeFlagging": true,
      "target": [
        "ads.fabrikam-drive.example",
        "telemetry.fabrikam-drive.example"
      ]
    }
  ]
}
